{
	"name": "@twistedandy/better-carousel",
	"version": "1.1.6",
	"description": "A small and fast carousel that takes all sizes, gaps and the layout from CSS.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TwistedAndy/better-carousel.git"
	},
	"homepage": "https://twistedandy.github.io/better-carousel/",
	"bugs": "https://github.com/TwistedAndy/better-carousel/issues",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/better-carousel.js",
	"module": "./dist/better-carousel.js",
	"types": "./src/types/better-carousel.d.ts",
	"exports": {
		".": {
			"types": "./src/types/better-carousel.d.ts",
			"import": "./dist/better-carousel.js",
			"default": "./dist/better-carousel.js"
		},
		"./css": "./dist/better-carousel.css",
		"./scss": "./src/styles/better-carousel.scss"
	},
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "rollup -c",
		"dev": "rollup -c -w",
		"docs": "node scripts/docs.mjs",
		"test": "node --test tests/",
		"e2e": "npm run build && node tests/e2e.mjs",
		"bench": "npm run build && npm install --prefix bench --no-audit --no-fund && npm start --prefix bench --"
	},
	"keywords": [
		"carousel",
		"slider",
		"css"
	],
	"license": "MIT",
	"author": "Andrii Toniievych",
	"devDependencies": {
		"@rollup/plugin-terser": "^1.0.2",
		"puppeteer-core": "^25.17.0",
		"rollup": "^4.68.4",
		"sass": "^1.108.2"
	}
}
